# Pik surfaces. Copy to .env (gitignored) and paste your own tokens after the = signs. Never commit .env.
# Slack (Socket Mode): Bot User OAuth Token (xoxb-...) and App-Level Token (xapp-..., scope connections:write)
PIK_SLACK_BOT_TOKEN=
PIK_SLACK_APP_TOKEN=
# Notion (internal integration) and the database id of the "Tickets" board
PIK_NOTION_TOKEN=
PIK_NOTION_DB=
# Optional: a LAN address so "Why? See the receipts" links open from a phone, e.g. http://192.168.1.20:8787
PIK_PUBLIC_URL=
# Optional: where the page's Join Meet / Open Slack / Open task board buttons go. Defaults: https://meet.google.com/new,
# https://slack.com/signin, and the board from PIK_NOTION_DB (a URL or a 32-hex id becomes https://www.notion.so/<id>)
PIK_MEET_URL=
PIK_SLACK_URL=
PIK_NOTION_URL=
# Optional: the page's mic button starts the listener (live.py). PIK_MIC = part of the input device name (default: the system
# default microphone). PIK_LISTEN_SPEAK=0 never plays Pik's voice (default 1: it speaks when addressed by name)
PIK_MIC=
PIK_LISTEN_SPEAK=
