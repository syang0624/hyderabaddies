# Pik surfaces. Copy to .env (gitignored) and paste your own tokens after the = signs. Never commit .env.
# Slack (Socket Mode): Bot User OAuth Token (xoxb-...) and App-Level Token (xapp-..., scope connections:write)
PIK_SLACK_BOT_TOKEN=
PIK_SLACK_APP_TOKEN=
# Notion (internal integration) and the database id of the "Tickets" board
PIK_NOTION_TOKEN=
PIK_NOTION_DB=
# Optional: a LAN address so "Why? See the receipts" links open from a phone, e.g. http://192.168.1.20:8787
PIK_PUBLIC_URL=
